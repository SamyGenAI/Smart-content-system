# Private vault (Samy-SmartOS). Relative to this repo, or absolute.
VAULT_PATH=../Samy-SmartOS

# Design OS: the Smart design system checkout. Every visual is built and rendered there.
DESIGN_SYSTEM_PATH=../smart-design-system

# social-listening (scripts/signals/social-listening.py). Each key is only
# needed for its source. Reddit, YouTube and keyless Web need nothing.
# LinkedIn source. https://console.apify.com/settings/integrations
APIFY_API_KEY=
# YouTube source, optional: reads videos without captions. https://aistudio.google.com/
GEMINI_API_KEY=
# Web source, optional. Without a key it uses DuckDuckGo, then Startpage.
# The first key found wins, in this order. https://dashboard.exa.ai/
BRAVE_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
PARALLEL_API_KEY=
